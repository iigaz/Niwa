<form>
    <div>
        <table>
            <colgroup>
                <col/>
                <col style="width: 100%"/>
            </colgroup>
            <tr>
                <th>
                    <label>Link</label>
                </th>
                <td>
                    <input type="url" required="required"/>
                </td>
            </tr>
            <tr>
                <th></th>
                <td>
                    <span class="information">Empty fields will be filled automatically.</span>
                </td>
            </tr>
            <tr>
                <th>
                    <label>Title</label>
                </th>
                <td>
                    <input type="text"/>
                </td>
            </tr>
            <tr>
                <th>
                    <label>Summary</label>
                </th>
                <td>
                    <textarea type="text" rows="5">
</textarea>
                </td>
            </tr>
            <tr>
                <th>
                    <label>Tags</label>
                </th>
                <td>
                    <input type="text" class="tag tag-input"/>
                </td>
            </tr>
            <tr>
                <th>
                    <label>Access</label>
                </th>
                <td>
                    <select>
                        <option value="private">Private</option>
                        <option value="public">Public</option>
                        <option value="linkonly">Link-Only</option>
                    </select>
                </td>
            </tr>
        </table>
    </div>
    <div class="footer">
        <button type="submit">Submit</button>
    </div>
</form>