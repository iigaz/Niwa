@using OpenGraphNet.Metadata
@using Niwa.Extensions
@using Niwa.Models
@using Niwa.Models.Enums
@using Niwa.Services
@using Niwa.Services.NoteServices
@using Niwa.Services.NoteServices.Models
@using OpenGraphNet
@using Niwa.Dtos.NoteDtos
@using Niwa.Dtos.FileDtos
@inject INoteCommandService NoteCommandService
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject IFileUploadService FileUploadService
@inject IConfiguration Configuration
<EditForm EditContext="EditContext" Enhance OnSubmit="OnSubmit" FormName="EditNote">
    <DataAnnotationsValidator/>
    <div>
        <table>
            <colgroup>
                <col/>
                <col style="width: 100%"/>
            </colgroup>
            @if (NoteVariant == Variant.Link)
            {
                <tr>
                    <th>
                        <label>Link</label>
                    </th>
                    <td>
                        <InputText type="url" required @bind-Value="Model!.Url"/>
                    </td>
                </tr>
                <tr>
                    <th></th>
                    <td>
                        <span class="information">Other fields will be filled automatically.</span>
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <th>
                        <label>Title</label>
                    </th>
                    <td>
                        <InputText @bind-Value="Model!.Title"/>
                    </td>
                </tr>
                <tr>
                    <th>
                        <label>Summary</label>
                    </th>
                    <td>
                        <InputTextArea @bind-Value="Model!.Summary" rows="5"></InputTextArea>
                    </td>
                </tr>
                <tr>
                    <th>
                        <label>Tags</label>
                    </th>
                    <td>
                        <InputText class="tag tag-input" @bind-Value="Model!.Tags"></InputText>
                    </td>
                </tr>
            }
            <tr>
                <th>
                    <label>Access</label>
                </th>
                <td>
                    <InputSelect @bind-Value="Model!.Access">
                        @foreach (var accessType in Enum.GetValues<Access>())
                        {
                            <option value="@accessType">@accessType.GetName()</option>
                        }
                    </InputSelect>
                </td>
            </tr>
        </table>
    </div>
    @if (NoteVariant != Variant.Link)
    {
        <div>
            <div class="content-header">
                <span class="information">Supports markdown.</span>
            </div>
            <InputTextArea rows="10" @bind-Value="Model!.Content"></InputTextArea>
        </div>
    }
    <ValidationSummary/>
    <div class="footer">
        <button type="submit">Submit</button>
    </div>
</EditForm>
@if (NoteId != null)
{
    <h5>Attachments</h5>
    <form method="post" data-enhance enctype="multipart/form-data" @formname="UploadFiles" @onsubmit="UploadFiles">
        <AntiforgeryToken/>
        <div>
            <input name="Files" type="file" multiple/>
            <button>Upload</button>
        </div>
    </form>
    <ul>
        @foreach (var attachment in Model?.Files ?? new List<NoteFileQueryDto>())
        {
            <li class="attachment">
                <a href="@attachment.FileUrl">@attachment.Filename</a>
                <form data-enhance method="post" @onsubmit="() => RemoveFile(attachment.OriginalNoteFile)" @formname="@("delete" + attachment.OriginalNoteFile.Id)">
                    <AntiforgeryToken/>
                    <button class="btn-link">Remove</button>
                </form>
            </li>
        }
    </ul>
}

@code {

    [Parameter]
    public EditNoteCommandDto? Model { get; set; }

    [Parameter]
    public Guid? NoteId { get; set; }

    [Parameter]
    public Guid? UserId { get; set; }

    [Parameter]
    public Garden? Garden { get; set; }

    [Parameter]
    public string? RedirectTo { get; set; }

    [Parameter]
    public Variant NoteVariant { get; set; }

    private EditContext? EditContext { get; set; }

    private ValidationMessageStore? MessageStore { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new EditNoteCommandDto();
        EditContext ??= new EditContext(Model);
        MessageStore ??= new ValidationMessageStore(EditContext);
    }

    public enum Variant
    {
        Plain,
        Link
    }

    private async Task OnSubmit()
    {
        if (NoteVariant == Variant.Link && Model != null)
        {
            try
            {
                var graph = await OpenGraph.ParseUrlAsync(Model.Url);
                var title = graph.Title.Length == 0 ? Model.Url : graph.Title;
                var link = graph.Url?.ToString() ?? Model.Url;
                var image = graph.Image?.ToString();
                var imageAlt = graph.Metadata["og:image"].FirstOrDefault()?.Properties["alt"].Value();
                var description = graph.Metadata["og:description"].Value();
                var tags = string.Join(' ', graph.Metadata["og:article"].FirstOrDefault()?.Properties["tag"] ?? []);
                Model.Title = title;
                Model.Summary = $"{description}";
                Model.Content = $"[{title}]({link})" + (image != null ? $"\n\n![{imageAlt}]({image})" : "");
                Model.Tags = tags;
            }
            catch
            {
                MessageStore?.Add(() => Model.Url, "Something went wrong. Try creating a plain note.");
                EditContext?.NotifyValidationStateChanged();
            }
        }

        var isValid = EditContext?.Validate() ?? false;

        if (!isValid)
            return;
        if (NoteId != null && Model != null)
        {
            var success = await NoteCommandService.UpdateAsync(new UpdateNoteCommand
            {
                Id = NoteId.Value,
                Title = Model.Title,
                Summary = Model.Summary,
                Content = Model.Content,
                Access = Model.Access,
                Tags = Model.Tags
            });
            if (success && RedirectTo != null)
                NavigationManager.NavigateTo(RedirectTo);
            if (!success)
            {
                MessageStore?.Add(() => Model.Tags, "Something went wrong. Please ensure your tags are within 32 characters and contain only small latin letters and symbols '-', '_' or '+'.");
                EditContext?.NotifyValidationStateChanged();
            }
        }

        if (NoteId == null && Model != null)
        {
            var note = await NoteCommandService.CreateAsync(new CreateNoteCommand
            {
                UserId = UserId!.Value,
                Garden = Garden!,
                Title = Model.Title,
                Summary = Model.Summary,
                Content = Model.Content,
                Access = Model.Access,
                Tags = Model.Tags
            });
            if (note != null && RedirectTo != null)
                NavigationManager.NavigateTo(RedirectTo);
            if (note != null)
            {
                NavigationManager.NavigateTo(LinkManager.LinkToNote(note));
            }
            else
            {
                MessageStore?.Add(() => Model.Tags, "Something went wrong. Please ensure your tags are within 32 characters and contain only small latin letters and symbols '-', '_' or '+'.");
                EditContext?.NotifyValidationStateChanged();
            }
        }
    }

    [SupplyParameterFromForm(FormName = "UploadFiles")]
    public IFormFileCollection? Files { get; set; }

    private async Task UploadFiles()
    {
        if (Files == null || Files.Count == 0)
            return;
        if (Model!.Files!.Count + Files.Count > 20)
        {
            MessageStore?.Add(() => Model!, "Sorry, but you cannot have more than 20 files on one note.");
            EditContext?.NotifyValidationStateChanged();
            return;
        }

        var maxSize = Configuration.GetSection("Niwa:MaxUploadSizeBytes").Get<long>();
        var getFiles = Files.GetFiles("Files");
        if (getFiles.Any(file => file.Length > maxSize))
        {
            MessageStore?.Add(() => Model!, "Files too large.");
            EditContext?.NotifyValidationStateChanged();
            return;
        }

        var files = await FileUploadService.UploadFilesAsync(getFiles);
        var success = await NoteCommandService.AddFilesAsync(NoteId!.Value, files.Select(file => new NoteFile
        {
            Filename = file.Filename,
            FileUrl = file.FileUrl,
            NoteId = NoteId!.Value
        }).ToList());
        if (!success)
        {
            MessageStore?.Add(() => Model!, "Something went wrong.");
            EditContext?.NotifyValidationStateChanged();
        }

        NavigationManager.NavigateTo(NavigationManager.Uri);
    }

    private async Task RemoveFile(NoteFile original)
    {
        await NoteCommandService.RemoveFileAsync(NoteId!.Value, original);
        NavigationManager.NavigateTo(NavigationManager.Uri);
    }

}