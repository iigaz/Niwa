@using Niwa.Dtos.NoteDtos
@using Niwa.Components.Cards
<div>
    <form data-enhance @formname="search">
        <input name="q" placeholder="Search query" type="search" value="@Query"/>
        <button>Search</button>
    </form>
</div>
@if (Notes.Count > 0)
{
    <div class="cards">
        @foreach (var note in Notes)
        {
            <NoteCard Model="@note"></NoteCard>
        }
    </div>
}
else
{
    <p>Nothing was found.</p>
}

@code {

    [Parameter]
    [EditorRequired]
    public List<NoteCardQueryDto> Notes { get; set; } = [];

    [Parameter]
    [EditorRequired]
    public string Query { get; set; } = "";

}