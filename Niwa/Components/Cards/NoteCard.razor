@using Niwa.Dtos.NoteDtos.Read
@using Niwa.Models.Enums
@using Niwa.Services
@inject ILinkManager LinkManager
<ImageCard CardImage="@Model.Image"
           CardImageAltText="@Model.Title">
    <CardTitle>
        <RegularLink To="@Model.Url">@Model.Title</RegularLink>
    </CardTitle>
    <CardDescription>
        <div class="description-info">
            <Markdown Content="@Model.Summary.ReplaceLineEndings(" ")"/>
        </div>
        <p class="actions-collection">
            <i>From @Model.Garden</i>
            @if (Model.Access != Access.Public)
            {
                <b>@(Model.Access.ToString())</b>
            }
            @* @if (Model.Collection != null) *@
            @* { *@
            @*     @(" ") *@
            @*     <span> *@
            @*         <i>In collection <a href="#">@Model.Collection</a></i> *@
            @*     </span> *@
            @* } *@
            @* @if (Model.RemoveFromCollectionAvailable) *@
            @* { *@
            @*     @(" ") *@
            @*     <a href="#" class="btn-link">Remove from collection</a> *@
            @* } *@
        </p>
        <p class="tags">
            @foreach (var tag in Model.Tags)
            {
                @(" ")
                <a href="#" class="tag">@tag</a>
            }
        </p>
    </CardDescription>
</ImageCard>

@code {

    [Parameter]
    [EditorRequired]
    public NoteCardDto Model { get; set; } = null!;

}