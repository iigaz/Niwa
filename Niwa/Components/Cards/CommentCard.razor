<div class="card">
    <div class="header">
        <span>@Author writes:</span>
        <span class="right">
            @PostDateTime
            @DeleteButton
        </span>
    </div>
    <div class="content">
        @Content
    </div>
</div>

@code {

    [Parameter]
    [EditorRequired]
    public RenderFragment Author { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public RenderFragment PostDateTime { get; set; } = null!;

    [Parameter]
    public RenderFragment? DeleteButton { get; set; }

    [Parameter]
    [EditorRequired]
    public RenderFragment Content { get; set; } = null!;

}