@using Niwa.Dtos.GardenDtos
@using Niwa.Services
@inject ILinkManager LinkManager 
<div class="card">
    <h5 class="title">
        <RegularLink To="@LinkManager.LinkToGarden(Model.AuthorUsername)">@Model.Title</RegularLink>
    </h5>
    <div class="description">
        <Markdown Content="@Model.Description?.ReplaceLineEndings(" ")"/>
    </div>
    <div class="footer">
        <span>Active since: @Model.ActiveSinceYear</span>
        <span>Last activity: @Model.LastActivityRelative</span>
        <span>@Model.PublicNotesCount public @(Model.PublicNotesCount == 1 ? "note" : "notes")</span>
        @if (Model.Tags.Count > 0)
        {
            <span>
                Popular tags:
                <span class="tags">
                    @foreach (var tag in Model.Tags)
                    {
                        @(" ")
                        <a href="@LinkManager.LinkToTag(tag)" class="tag">@tag</a>
                    }
                </span>
            </span>
        }
    </div>
</div>

@code {

    [Parameter]
    [EditorRequired]
    public GardenCardQueryDto Model { get; set; } = null!;

}