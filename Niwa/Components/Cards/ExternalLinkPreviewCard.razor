<ImageCard CardImage="@Model.LinkImage"
           CardImageAltText="@Model.LinkTitle">
    <CardTitle>
        <a target="_blank" href="@Model.LinkUrl">@Model.LinkTitle</a>
    </CardTitle>
    <CardDescription>
        <a target="_blank" href="@Model.LinkUrl" class="url">@Model.LinkUrl</a>
        <p class="description-info">@Model.LinkDescription</p>
        <p class="information access-date">Access date: @Model.AccessDate</p>
    </CardDescription>
    <CardFooter>
        <a target="_blank" href="@Model.LinkUrl" class="btn-link">Visit link</a>
        <a target="_blank" href="https://web.archive.org/web/*/@Model.LinkUrl" class="btn-link">View on Wayback Machine</a>
    </CardFooter>
</ImageCard>

@code {

    private string? _description;

    [Parameter]
    [EditorRequired]
    public ExternalLinkTemp Model { get; set; } = null!;

    public class ExternalLinkTemp
    {
        public string? LinkTitle { get; set; }
        public string? LinkImage { get; set; }
        public string? LinkUrl { get; set; }
        public string? LinkDescription { get; set; }
        public string? AccessDate { get; set; }
    }


}