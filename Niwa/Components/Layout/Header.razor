@using Niwa.Services
@inject ILinkManager LinkManager
<header>
    <div class="left">
        <h4>
            <a href="/">Niwa</a>
        </h4>
        <a href="/search" class="btn-link">Search notes</a>
    </div>
    <div class="center">
        <b>
            <HeaderTitleOutlet/>
        </b>
    </div>
    <div class="right">
        <AuthorizeView>
            <Authorized>
                <h5>
                    <a href="@LinkManager.LinkToGarden(context.User.Identity!.Name!)">@context.User.Identity.Name</a>
                </h5>
            </Authorized>
            <NotAuthorized>
                <h5>
                    <a href="/login">Login</a>
                </h5>
                <h5>
                    <a href="/register">Register</a>
                </h5>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</header>

