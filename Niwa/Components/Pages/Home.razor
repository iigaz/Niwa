@page "/"
@using Niwa.Dtos.GardenDtos.Read
@using Niwa.Services.GardenServices
@using Niwa.Components.Cards
@inject NavigationManager NavigationManager
@inject IGardenQueryService GardenQueryService
@inject IConfiguration Configuration

<TwoPanelBanner>
    <BannerLeft>
        <h1>Niwa</h1>
        <div class="landing-description"><b>Your</b> digital garden.</div>
        <div class="landing-buttons">
            <a class="btn" href="/login">Log in</a>
            <a class="btn" href="/register">Register</a>
        </div>
    </BannerLeft>
    <BannerRight>
        <img src="asianpotflower.svg" alt="Asian Pot Flower"/>
    </BannerRight>
</TwoPanelBanner>

<div class="landing-details">
    <h3>What is a digital garden?</h3>
    <figure>
        <blockquote>
            <p>A garden is something inbetween a personal blog and a wiki. It&#39;s a collection of evolving notes, essays, and ideas that aren&#39;t strictly organised by their publication date. They&#39;re inherently exploratory – posts are linked through contextual associations. They aren&#39;t refined or complete - posts can be published as half-finished thoughts that will grow and evolve over time. They&#39;re less rigid, less performative, and less perfect than the personal &quot;blogs&quot; we&#39;re used to encountering on the web.</p>
        </blockquote>
        <figcaption>
            Extract from
            <cite>
                <a target="_blank" href="https://github.com/MaggieAppleton/digital-gardeners?tab=readme-ov-file#what-is-digital-gardening">MaggieAppleton - Digital Gardeners</a>
            </cite>
        </figcaption>
    </figure>
</div>

<div>
    @if (FeaturedGardens.Count > 0)
    {
        <h2 class="right">Explore the gardens</h2>
        <div class="cards">
            @foreach (var garden in FeaturedGardens)
            {
                <GardenCard Model="garden"/>
            }
        </div>
        <h2>Or <a href="/register">start your own</a>.</h2>
    }
    else
    {
        <h2>Want to try? <a href="/register">Start your own garden</a>.</h2>
    }
</div>

@code {

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private List<GardenCardDto> FeaturedGardens { get; set; } = new();

    protected override void OnInitialized()
    {
        if (HttpContext.User.Identity?.IsAuthenticated ?? false)
            NavigationManager.NavigateTo("/feed");
    }

    protected override async Task OnInitializedAsync()
    {
        var ids = Configuration.GetSection("FeaturedGardens").Get<List<string>>()?.Select(Guid.Parse) ?? [];
        var gardens = await GardenQueryService.GetGardensWithStatsByIdsAsync(ids.ToList());
        FeaturedGardens = gardens.Select(GardenCardDto.From).ToList();
    }

}