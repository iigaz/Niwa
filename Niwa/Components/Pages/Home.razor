        </GardenCard>
    </div>
    <h2>Or <a href="/register">start your own</a>.</h2>
</div>

@code {

    private static bool LoggedIn => false;

    protected override void OnInitialized()
    {
        if (LoggedIn)
            NavigationManager.NavigateTo("/feed");
        base.OnInitialized();
    }

}