@page "/collection/{CollectionId}"
@using Niwa.Models
@using Niwa.Services.CollectionServices
@using Niwa.Services.Converters
@using Niwa.Components.Forms
@inject ICollectionQueryService CollectionQueryService
@inject INoteToNoteCardConverter NoteToNoteCardConverter

@if (IsSuccessfullyInitialized)
{
    <PageTitle>@Model!.Title</PageTitle>
    <HeaderTitle>@Model!.Title</HeaderTitle>

    <h3>Collection: @Model!.Title</h3>

    <NoteSearchForm Notes="Model!.Notes.Select(NoteToNoteCardConverter.Convert).ToList()" Query="@Query"></NoteSearchForm>
}
else
{
    <Error/>
}

@code {

    [Parameter]
    public string CollectionId { get; set; } = null!;

    private Collection? Model { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var parsed = Guid.TryParse(CollectionId, out var collectionId);
        if (!parsed)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        Model ??= await CollectionQueryService.GetById(collectionId);
        IsSuccessfullyInitialized = true;
    }

}