@page "/feed"
@using System.Security.Claims
@using Niwa.Extensions
@using Niwa.Models
@using Niwa.Services
@using Niwa.Services.CollectionServices
@using Niwa.Services.GardenServices
@using Niwa.Services.NewsServices
@using Niwa.Services.NewsServices.Models
@using Niwa.Dtos.GardenDtos
@using Niwa.Components.Cards
@inject IGardenQueryService GardenQueryService
@inject IConfiguration Configuration
@inject ILinkManager LinkManager
@inject ICollectionQueryService CollectionQueryService
@inject INewsQueryService NewsQueryService

@if (IsSuccessfullyInitialized)
{
    <AuthorizeView>
        <Authorized>
            <h1>Welcome back, @(context.User.Identity!.Name)!</h1>
            <ActionsContainer>
                <ActionsLeft>
                    <ActionLink To="@LinkManager.LinkToGarden(context.User.Identity!.Name!)">View garden</ActionLink>
                </ActionsLeft>
                <ActionsRight>
                    <ActionLink To="@LinkManager.LinkToNewNote(context.User.Identity!.Name!, "plain")">New plain note</ActionLink>
                    <ActionLink To="@LinkManager.LinkToNewNote(context.User.Identity!.Name!, "link")">New link note</ActionLink>
                </ActionsRight>
            </ActionsContainer>

            @if (News.Count > 0)
            {
                <hr/>

                <h3>News</h3>

                <ul>
                    @foreach (var newsModel in News.Take(_newsLimit))
                    {
                        <li>@newsModel.DateTime.TimeAgo(): @newsModel.Title @newsModel.Information</li>
                    }

                    @if (News.Count > _newsLimit)
                    {
                        <li class="end">
                            <ActionLink To="/feed/news">Read more</ActionLink>
                        </li>
                    }
                </ul>
            }

            @if (Collections.Count > 0)
            {
                <hr/>

                <h3>Collections</h3>

                <ul>
                    @foreach (var collection in Collections)
                    {
                        <li>
                            <RegularLink To="@LinkManager.LinkToCollection(collection.Id)">@collection.Title</RegularLink>
                        </li>
                    }
                </ul>
            }

            <hr/>

            <h3>Featured Gardens</h3>

            <div class="cards">
                @foreach (var garden in FeaturedGardens)
                {
                    <GardenCard Model="garden"/>
                }
            </div>
        </Authorized>
    </AuthorizeView>
}
else
{
    <Error/>
}

@code {

    private Guid _userId;

    private int _newsLimit;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private List<GardenCardQueryDto> FeaturedGardens { get; set; } = [];
    private List<Collection> Collections { get; set; } = [];
    private List<NewsModel> News { get; set; } = [];

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out _userId);
        if (!parsed)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status401Unauthorized;
            return;
        }

        var ids = Configuration.GetSection("Niwa:FeaturedGardens").Get<List<string>>()?.Select(Guid.Parse) ?? [];
        var gardens = await GardenQueryService.GetGardensWithStatsByIdsAsync(ids.ToList());
        FeaturedGardens = gardens.Select(GardenCardQueryDto.From).ToList();
        Collections = await CollectionQueryService.GetUserCollections(_userId);
        _newsLimit = Configuration.GetSection("Niwa:NewsOnMainPage").Get<int>();
        News = await NewsQueryService.GetNewsAsync(_userId, _newsLimit + 1);
        IsSuccessfullyInitialized = true;
    }

}