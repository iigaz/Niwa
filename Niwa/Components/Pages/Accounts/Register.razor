@page "/register"
@using System.ComponentModel.DataAnnotations
@using Niwa.Models.Meta

<TwoPanelBanner>
    <BannerLeft>
        <img src="bonsaiwithflower.svg" alt="Bonsai With Flower"/>
    </BannerLeft>
    <BannerRight>
        <h1>Register</h1>
        <form>
            <div>
                <label for="username">Username</label>
                <input id="username" type="text"/>
            </div>
            <div>
                <label for="password">Password</label>
                <input id="password" type="password"/>
            </div>
            <div>
                <label for="repeat-password">Repeat password</label>
                <input id="repeat-password" type="password"/>
            </div>
        </form>
        <ActionsContainer>
            <ActionsLeft>
                <a href="/login" class="btn-link">I already have an account</a>
            </ActionsLeft>
            <ActionsRight>
                <button>Register</button>
            </ActionsRight>
        </ActionsContainer>
    </BannerRight>
</TwoPanelBanner>

@code {

    public class RegisterDto
    {
        [Length(Lengths.UsernameMin, Lengths.UsernameMax)]
        [RegularExpression(@"[-a-z0-9_]+")]
        public string Username { get; set; } = null!;

        [Length(8, 2048)]
        [RegularExpression("^(?=.*\\d)(?=.*[A-Z])(?=.*[a-z])(?=.*[^\\w\\d\\s:])([^\\s]){8,2048}$")]
        public string Password { get; set; } = null!;
    }

}