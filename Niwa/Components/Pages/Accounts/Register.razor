@page "/register"
@using Niwa.Services.RegistrationServices
@using Niwa.Services
@using System.ComponentModel.DataAnnotations
@using Niwa.Models.Meta
@inject IRegistrationCommandService RegistrationCommandService
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@inject ITurnstileValidatorService TurnstileValidatorService

<PageTitle>Register</PageTitle>
<HeaderTitle>Register</HeaderTitle>

<TwoPanelBanner>
    <BannerLeft>
        <img src="bonsaiwithflower.svg" alt="Bonsai With Flower"/>
    </BannerLeft>
    <BannerRight>
        <h1>Register</h1>
        @if (RegistrationOpen)
        {
            <EditForm EditContext="EditContext" Enhance FormName="RegisterForm" OnValidSubmit="Submit">
                <div class="form">
                    <DataAnnotationsValidator/>
                    <div>
                        <label>
                            Username
                            <InputText @bind-Value="Model!.Username"/>
                        </label>
                    </div>
                    <div>
                        <label>
                            Password
                            <InputText type="password" @bind-Value="Model!.Password"></InputText>
                        </label>
                    </div>
                    <div>
                        <label>
                            Repeat Password
                            <InputText type="password" @bind-Value="Model!.RepeatPassword"></InputText>
                        </label>
                    </div>
                    <div class="cf-turnstile" data-sitekey="@Configuration["Turnstile:SiteKey"]" data-response-field-name="Model.TurnstileToken">
                        <a data-enhance-nav="false" href="@NavigationManager.Uri">Captcha didn't load? Click here to refresh the page.</a>
                    </div>
                    <ValidationSummary/>
                    <ActionsContainer>
                        <ActionsLeft>
                            <a href="/login" class="btn-link">I already have an account</a>
                        </ActionsLeft>
                        <ActionsRight>
                            <button>Register</button>
                        </ActionsRight>
                    </ActionsContainer>
                </div>
            </EditForm>
        }
        else
        {
            <p>Registration closed. Come back another time.</p>
        }
    </BannerRight>
</TwoPanelBanner>

@code {

    [SupplyParameterFromForm]
    public RegisterDto? Model { get; set; }

    private EditContext? EditContext { get; set; }

    private ValidationMessageStore? MessageStore { get; set; }

    private bool RegistrationOpen { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new RegisterDto();
        EditContext ??= new EditContext(Model);
        MessageStore ??= new ValidationMessageStore(EditContext);
        EditContext.OnValidationRequested += EditContextOnOnValidationRequested;
        RegistrationOpen = Configuration.GetSection("Niwa:RegistrationOpen").Get<bool>();
    }

    private void EditContextOnOnValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        if (Model!.RepeatPassword != Model!.Password)
        {
            MessageStore?.Add(() => Model.RepeatPassword, "Passwords are not the same.");
        }
    }

    private async Task Submit()
    {
        var token = Model?.TurnstileToken;
        var validated = token != null && await TurnstileValidatorService.ValidateAsync(token);
        if (!validated)
        {
            MessageStore?.Add(() => Model!, "Could not validate captcha.");
            EditContext?.NotifyValidationStateChanged();
            return;
        }

        var username = Model!.Username;
        var password = Model!.Password;
        var validationResults = await RegistrationCommandService.RegisterAsync(username, password);
        if (validationResults != null)
        {
            var result = validationResults.First();
            MessageStore?.Add(() => Model.Username, result.ErrorMessage ?? "Something went wrong.");
            EditContext?.NotifyValidationStateChanged();
        }
        else
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    public class RegisterDto
    {
        [Length(Lengths.UsernameMin, Lengths.UsernameMax)]
        [RegularExpression(@"[-a-z0-9_]+")]
        public string Username { get; set; } = null!;

        [Length(8, 2048)]
        [RegularExpression(@"^(?=.*\d)(?=.*[A-Z])(?=.*[a-z])(?=.*[^\w\d\s:])([^\s]){8,2048}$")]
        public string Password { get; set; } = null!;

        [Length(8, 2048)]
        public string RepeatPassword { get; set; } = null!;

        public string? TurnstileToken { get; set; }
    }

}