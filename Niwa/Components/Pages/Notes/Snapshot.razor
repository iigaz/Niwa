@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}/snapshot/{SnapshotId}"
@using System.Security.Claims
@using Niwa.Extensions
@using Niwa.Helpers
@using Niwa.Models.Enums
@using Niwa.Services
@using Niwa.Services.NoteServices
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject INoteQueryService NoteQueryService

@if (IsSuccessfullyInitialized)
{
    <PageTitle>Snapshot - @_note!.Title</PageTitle>
    <HeaderTitle>
        <RegularLink To="@LinkManager.LinkToNote(_note!)">@_note!.Title</RegularLink>
    </HeaderTitle>
    <ActionsContainer>
        <ActionsLeft>
            @if (Model!.Access != Access.Public)
            {
                <b>@Model.Access.GetName()</b>
            }
            <span>Viewing snapshot from @Model.LatestRevision.CreatedDateTime</span>
        </ActionsLeft>
        <ActionsRight>
            <ActionLink To="@LinkManager.LinkToHistory(_note!)">Back</ActionLink>
        </ActionsRight>
    </ActionsContainer>

    <h1>@Model!.Title</h1>

    <blockquote>
        <Markdown Content="@Model.Summary"></Markdown>
    </blockquote>

    <div class="contents">
        <Markdown Content="@Model.Content"></Markdown>
    </div>

    <hr/>

    <div class="details">
        <div>
            <label>Attachments are not available in snapshots.</label>
        </div>
        @if (Model.Tags.Count > 0)
        {
            <div>
                <label>Tags:</label>
                <span class="inline-list">
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="@LinkManager.LinkToTag(tag.Tag)" class="tag">@tag.Tag</a>
                    }
                </span>
            </div>
        }
        <div>
            <ActionLink To="@LinkManager.LinkToNote(Model)">Go back to latest version</ActionLink>
        </div>
    </div>
}
else
{
    <Error/>
}

@code {

    [Parameter]
    public Models.Note? Model { get; set; }

    private Models.Note? _note;

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [Parameter]
    public string SnapshotId { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _note = await NoteQueryService.GetNoteByUsernameAndShortIdAsync(AuthorUsername, NoteShortId);

        if (_note == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out var currentUserGuid);
        IsCurrentUserAuthor = parsed && _note.UserId == currentUserGuid;

        if (_note.Access == Access.Private && !IsCurrentUserAuthor)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var slug = SlugGenerator.FromTitle(_note.Title);
        if (NoteSlug != slug)
        {
            NavigationManager.NavigateTo(LinkManager.LinkToSnapshot(_note, SnapshotId));
            return;
        }

        var parsed2 = Guid.TryParse(SnapshotId, out var revisionId);
        Model = parsed2 ? await NoteQueryService.GetNoteSnapshotAsync(_note, revisionId) : null;
        if (!parsed2 || Model == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        IsSuccessfullyInitialized = true;
    }

}