@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}/edit"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Niwa.Dtos.NoteDtos
@using Niwa.Helpers
@using Niwa.Services
@using Niwa.Services.Converters
@using Niwa.Services.NoteServices
@using Niwa.Components.Forms
@inject INoteQueryService NoteQueryService
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject INoteFileToNoteFileConverter NoteFileToNoteFileConverter

@if (IsSuccessfullyInitialized)
{
    <PageTitle>Edit note - @_note!.Title</PageTitle>
    <HeaderTitle>
        <RegularLink To="@LinkManager.LinkToNote(_note!)">@_note!.Title</RegularLink>
    </HeaderTitle>
    <h5>Edit note</h5>
    <NoteEditForm Model="Model" NoteId="_note?.Id" RedirectTo="@LinkManager.LinkToNote(_note!)"/>
}
else
{
    <Error/>
}

@code {

    private Models.Note? _note;

    [SupplyParameterFromForm]
    public EditNoteCommandDto? Model { get; set; }

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _note = await NoteQueryService.GetNoteByUsernameAndShortIdAsync(AuthorUsername, NoteShortId);

        if (_note == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out var currentUserGuid);
        IsCurrentUserAuthor = parsed && _note.UserId == currentUserGuid;

        if (!IsCurrentUserAuthor)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var slug = SlugGenerator.FromTitle(_note.Title);
        if (NoteSlug != slug)
        {
            NavigationManager.NavigateTo(LinkManager.LinkToNote(_note));
            return;
        }

        IsSuccessfullyInitialized = true;
        Model ??= new EditNoteCommandDto
        {
            Title = _note.Title,
            Summary = _note.Summary,
            Content = _note.Content,
            Access = _note.Access,
            Tags = string.Join(' ', _note.Tags.Select(tag => tag.Tag))
        };
        Model.Files = (await Task.WhenAll(_note.Files.Select(async file => await NoteFileToNoteFileConverter.Convert(file)))).ToList();
    }

}