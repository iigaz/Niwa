@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}"
@using System.Security.Claims
@using Niwa.Extensions
@using Niwa.Helpers
@using Niwa.Models.Enums
@using Niwa.Services
@using Niwa.Services.CollectionServices
@using Niwa.Services.Converters
@using Niwa.Services.NoteServices
@using Niwa.Dtos.NoteDtos
@using System.Globalization
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject INoteQueryService NoteQueryService
@inject INoteToNotePageConverter NoteToNotePageConverter
@inject ICollectionQueryService CollectionQueryService

@if (IsSuccessfullyInitialized)
{
    <HeaderTitle LinkTo="@LinkManager.LinkToGarden(Model.Garden.AuthorUsername)">@Model.Garden.Title</HeaderTitle>

    <ActionsContainer>
        <ActionsLeft>
            @if (Model.Access != Access.Public)
            {
                <b>@Model.Access.ToString()</b>
            }
            @if (Model.Collection != null)
            {
                <span class="actions-collection">
                    <i>In collection</i>
                    <RegularLink To="@LinkManager.LinkToCollection(Model.Collection.Id)">@Model.Collection.Id</RegularLink>
                </span>
            }
        </ActionsLeft>
        <ActionsRight>
            <AuthorizeView>
                <Authorized>
                    <ActionLink To="collection" RelativeTo="@NavigationManager.Uri">@(Model.Collection == null ? "Add to collection" : "Change collection")</ActionLink>
                </Authorized>
            </AuthorizeView>
            <ActionLink To="edit" RelativeTo="@NavigationManager.Uri">Edit</ActionLink>
        </ActionsRight>
    </ActionsContainer>

    <h1>@Model.Title</h1>

    <blockquote>
        <Markdown Content="@Model.Summary"></Markdown>
    </blockquote>

    <div class="contents">
        <Markdown Content="@Model.Content"></Markdown>
    </div>

    <hr/>

    <div class="details">
        @if (Model.Attachments.Count > 0)
        {
            <div>
                <label>Attachments:</label>
                <span class="inline-list">
                    @foreach (var attachment in Model.Attachments)
                    {
                        <a href="@attachment.FileUrl">@attachment.Filename</a>
                    }
                </span>
            </div>
        }
        @if (Model.Tags.Count > 0)
        {
            <div>
                <label>Tags:</label>
                <span class="inline-list">
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="@LinkManager.LinkToTag(tag)">@tag</a>
                    }
                </span>
            </div>
        }
        <div>
            <label>Last revision:</label>
            <span title="@Model.LatestUpdateDateTime.ToString(CultureInfo.InvariantCulture)">@Model.LatestUpdateDateTime.TimeAgo()</span>
            <ActionLink To="history" RelativeTo="@NavigationManager.Uri">View history</ActionLink>
        </div>
        <div>
            <AuthorizeView>
                <Authorized>
                    @if (IsCurrentUserSubscribed)
                    {
                        <ActionLink To="unsubscribe" RelativeTo="@NavigationManager.Uri">Unsubscribe</ActionLink>
                    }
                    else
                    {
                        <ActionLink To="subscribe" RelativeTo="@NavigationManager.Uri">Subscribe to updates</ActionLink>
                    }
                </Authorized>
            </AuthorizeView>
            <ActionLink To="comments" RelativeTo="@NavigationManager.Uri">View comments (@Model.CommentCount)</ActionLink>
        </div>
    </div>
}
else
{
    <Error/>
}

@code {

    [Parameter]
    public NotePageQueryDto Model { get; set; } = null!;

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    private bool IsCurrentUserSubscribed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var note = await NoteQueryService.GetNoteByUsernameAndShortIdAsync(AuthorUsername, NoteShortId);

        if (note == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out var currentUserGuid);
        IsCurrentUserAuthor = parsed && note.UserId == currentUserGuid;

        if (note.Access == Access.Private && !IsCurrentUserAuthor)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var slug = SlugGenerator.FromTitle(note.Title);
        if (NoteSlug != slug)
        {
            NavigationManager.NavigateTo(LinkManager.LinkToNote(note));
            return;
        }

        if (parsed) IsCurrentUserSubscribed = await NoteQueryService.IsUserSubscribedAsync(currentUserGuid, note);

        var commentCount = await NoteQueryService.GetCommentCountAsync(note);
        var collection = parsed ? await CollectionQueryService.GetNoteCollection(currentUserGuid, note) : null;

        IsSuccessfullyInitialized = true;
        Model = NoteToNotePageConverter.Convert(note, commentCount, collection);
    }

}