@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}"
@using System.Security.Claims
@using Niwa.Extensions
@using Niwa.Models.Enums
@using Niwa.Services
@using Niwa.Dtos.GardenDtos
@using Niwa.Dtos.FileDtos
@using System.Globalization
@inject IShortIdParser ShortIdParser
@inject NavigationManager NavigationManager

@if (IsSuccessfullyInitialized)
{
    <HeaderTitle>@Model.Title - @Model.Garden.Title</HeaderTitle>

    <ActionsContainer>
        <ActionsLeft>
            @if (Model.Access != Access.Public)
            {
                <b>@Model.Access.ToString()</b>
            }
            @* <span class="actions-collection"> *@
            @*     <i>In collection</i> *@
            @*     <a href="#">Reading</a> *@
            @* </span> *@
        </ActionsLeft>
        <ActionsRight>
            @* <a href="/garden/123456/shower-me-with-divine-love/collection" class="btn-link">Change collection</a> *@
            <ActionLink To="edit" RelativeTo="@NavigationManager.Uri">Edit</ActionLink>
        </ActionsRight>
    </ActionsContainer>

    <h1>@Model.Title</h1>

    <blockquote>
        <Markdown Content="@Model.Summary"></Markdown>
    </blockquote>

    <div class="contents">
        <Markdown Content="@Model.Content"></Markdown>
    </div>

    <hr/>

    <div class="details">
        @if (Model.Attachments.Count > 0)
        {
            <div>
                <label>Attachments:</label>
                <span class="inline-list">
                    @foreach (var attachment in Model.Attachments)
                    {
                        <a href="@attachment.FileUrl">@attachment.Filename</a>
                    }
                </span>
            </div>
        }
        @if (Model.Tags.Count > 0)
        {
            <div>
                <label>Tags:</label>
                <span class="inline-list">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </span>
            </div>
        }
        <div>
            <label>Last revision:</label>
            <span title="@Model.LatestUpdateDateTime.ToString(CultureInfo.InvariantCulture)">@Model.LatestUpdateDateTime.TimeAgo()</span>
            <ActionLink To="history" RelativeTo="@NavigationManager.Uri">View history</ActionLink>
        </div>
        <div>
            <AuthorizeView>
                <Authorized>
                    @if (IsCurrentUserSubscribed)
                    {
                        <ActionLink To="unsubscribe" RelativeTo="@NavigationManager.Uri">Unsubscribe</ActionLink>
                    }
                    else
                    {
                        <ActionLink To="subscribe" RelativeTo="@NavigationManager.Uri">Subscribe to updates</ActionLink>
                    }
                </Authorized>
            </AuthorizeView>
            <ActionLink To="comments" RelativeTo="@NavigationManager.Uri">View comments (@Model.CommentCount)</ActionLink>
        </div>
    </div>
}
else
{
    <Error/>
}

@code {

    [Parameter]
    public NoteTemp Model { get; set; } = null!;

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; } = false;

    private bool IsCurrentUserAuthor { get; set; }

    private bool IsCurrentUserSubscribed { get; }

    protected override async Task OnInitializedAsync()
    {
        var createdDateTime = ShortIdParser.ShortIdToDateTime(NoteShortId);

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out var currentUserGuid);
        // IsCurrentUserAuthor = parsed && garden.UserId == currentUserGuid;
        // TODO: get note and compare note author to current user
    }

    public class NoteTemp
    {
        public string Title { get; set; } = null!;
        public Access Access { get; set; }
        public GardenLinkInfoQueryDto Garden { get; set; } = null!;
        public Guid AuthorUserId { get; set; }
        public string Summary { get; set; } = null!;
        public string Content { get; set; } = null!;
        public List<NoteFileQueryDto> Attachments { get; set; } = null!;
        public List<string> Tags { get; set; } = null!;
        public DateTime LatestUpdateDateTime { get; set; }
        public int CommentCount { get; set; }
    }

}