@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}/comments"
@using System.Security.Claims
@using System.Web
@using Niwa.Extensions
@using Niwa.Helpers
@using Niwa.Models
@using Niwa.Models.Enums
@using Niwa.Models.Meta
@using Niwa.Services
@using Niwa.Services.CommentServices
@using Niwa.Services.NoteServices
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject INoteQueryService NoteQueryService
@inject ICommentQueryService CommentQueryService
@inject ICommentCommandService CommentCommandService


@if (IsSuccessfullyInitialized)
{
    <PageTitle>Comments - @_note!.Title</PageTitle>
    <HeaderTitle>
        <RegularLink To="@LinkManager.LinkToNote(_note!)">@_note!.Title</RegularLink>
    </HeaderTitle>
    <h5>Comments</h5>
    <AuthorizeView Context="authContext">
        <Authorized>
            <div>
                @if (_replyToGuid != Guid.Empty)
                {
                    <p>Replying to <RegularLink To="@("#" + ReplyTo)" RelativeTo="@NavigationManager.Uri">@ReplyToAuthor</RegularLink>:</p>
                }
                <EditForm EditContext="EditContext" Enhance FormName="LeaveComment" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator/>
                    <div class="form">
                        <InputTextArea placeholder="Write your thoughts" @bind-Value="Model!.Content"></InputTextArea>
                        <ValidationSummary/>
                        <button>Post</button>
                    </div>
                </EditForm>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (CommentsList.Count > 0)
    {
        <div class="cards">
            @foreach (var comment in CommentsList)
            {
                <div class="card" id="@comment.Id">
                    <div class="header">
                        @if (comment.ParentId == null)
                        {
                            <span>
                                <RegularLink To="@LinkManager.LinkToGarden(comment.User.Username)">
                                    @comment.User.Username
                                </RegularLink> writes:
                            </span>
                        }
                        else
                        {
                            <span>
                                <RegularLink To="@LinkManager.LinkToGarden(comment.User.Username)">
                                    @comment.User.Username
                                </RegularLink>
                                replies to
                                @if (comment.Parent!.Deleted)
                                {
                                    @("[deleted comment]")
                                }
                                else
                                {
                                    <RegularLink To="@("#" + comment.ParentId)" RelativeTo="@(new Uri(NavigationManager.Uri).AbsolutePath)">
                                        @comment.Parent!.User.Username
                                    </RegularLink>
                                }
                                :
                            </span>
                        }
                        <span class="right">
                            <span title="@comment.CreatedDateTime.ToString(CultureInfo.InvariantCulture)">@comment.CreatedDateTime.TimeAgo()</span>

                            <AuthorizeView>
                                <Authorized>
                                    @if (_currentUserId == comment.UserId)
                                    {
                                        <form method="post" data-enhance @formname="@("delete" + comment.Id)" @onsubmit="() => DeleteComment(comment.Id)">
                                            <AntiforgeryToken/>
                                            <button class="btn-link">Delete</button>
                                        </form>
                                    }
                                    <ActionLink To="@("?replyTo=" + HttpUtility.UrlEncode(comment.Id.ToString()) + "&replyToAuthor=" + HttpUtility.UrlEncode(comment.User.Username))" RelativeTo="@(new Uri(NavigationManager.Uri).AbsolutePath)">
                                        Reply
                                    </ActionLink>
                                </Authorized>
                            </AuthorizeView>
                        </span>
                    </div>
                    <div class="content">
                        <Markdown Content="@comment.Content"/>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p>Be the first to leave a comment.</p>
    }
}
else
{
    <Error/>
}

@code {

    private Models.Note? _note;

    [SupplyParameterFromForm]
    public CommentCommandTemp? Model { get; set; }

    public List<Comment> CommentsList { get; set; } = [];

    private EditContext? EditContext { get; set; }

    private ValidationMessageStore? MessageStore { get; set; }

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [SupplyParameterFromQuery]
    public string ReplyTo { get; set; } = "";

    [SupplyParameterFromQuery]
    public string ReplyToAuthor { get; set; } = "";

    private Guid _replyToGuid;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private Guid _currentUserId;

    private bool IsSuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _note = await NoteQueryService.GetNoteByUsernameAndShortIdAsync(AuthorUsername, NoteShortId);
        Guid.TryParse(ReplyTo, out _replyToGuid);

        if (_note == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out _currentUserId);
        IsCurrentUserAuthor = parsed && _note.UserId == _currentUserId;

        if (_note.Access == Access.Private && !IsCurrentUserAuthor)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var slug = SlugGenerator.FromTitle(_note.Title);
        if (NoteSlug != slug)
        {
            NavigationManager.NavigateTo(LinkManager.LinkToNote(_note));
            return;
        }

        CommentsList = await CommentQueryService.GetNoteCommentsAsync(_note.Id);

        Model ??= new CommentCommandTemp();
        EditContext ??= new EditContext(Model);
        MessageStore ??= new ValidationMessageStore(EditContext);
        IsSuccessfullyInitialized = true;
    }

    public class CommentCommandTemp
    {
        [Length(Lengths.CommentContentMin, Lengths.CommentContentMax)]
        public string Content { get; set; } = "";
    }

    private async Task OnValidSubmit()
    {
        var success = await CommentCommandService.CreateComment(_currentUserId, _note!.Id, _replyToGuid == Guid.Empty ? null : _replyToGuid, Model!.Content);
        if (success)
        {
            NavigationManager.NavigateTo(new Uri(NavigationManager.Uri).AbsolutePath);
        }
        else
        {
            MessageStore?.Add(() => Model.Content, "Something went wrong.");
            EditContext?.NotifyValidationStateChanged();
        }
    }

    private async Task DeleteComment(Guid commentId)
    {
        var success = await CommentCommandService.DeleteComment(_currentUserId, commentId);
        if (success)
        {
            NavigationManager.NavigateTo(new Uri(NavigationManager.Uri).AbsolutePath);
        }
    }

}