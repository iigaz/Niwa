@page "/garden/{AuthorUsername}/{NoteShortId}/{NoteSlug?}/history"
@using System.Security.Claims
@using Niwa.Extensions
@using Niwa.Helpers
@using Niwa.Models
@using Niwa.Models.Enums
@using Niwa.Services
@using Niwa.Services.NewsServices
@using Niwa.Services.NoteServices
@inject ILinkManager LinkManager
@inject INoteQueryService NoteQueryService
@inject NavigationManager NavigationManager
@inject INewsQueryService NewsQueryService
@if (IsSuccessfullyInitialized)
{
    <PageTitle>Revision history - @_note!.Title</PageTitle>
    <HeaderTitle>
        <RegularLink To="@LinkManager.LinkToNote(_note!)">@_note!.Title</RegularLink>
    </HeaderTitle>
    <h5>Revision history</h5>

    <table>
        @foreach (var revision in Model)
        {
            <tr>
                <td>
                    <span title="@revision.CreatedDateTime">@revision.CreatedDateTime.TimeAgo()</span>
                </td>

                @if (revision.PreviousRevisionId != null)
                {
                    <td>@NewsQueryService.GetNoteRevisionDescription(revision)</td>
                }
                else if (revision.TitleRewritten)
                {
                    <td>Created &ldquo;@revision.TitleDelta&rdquo;.</td>
                }
                <td>
                    <ActionLink To="@LinkManager.LinkToSnapshot(_note!, revision.Id.ToString())">View snapshot</ActionLink>
                </td>
            </tr>
        }
    </table>
}
else
{
    <Error/>
}

@code {

    [Parameter]
    public List<NoteRevision> Model { get; set; } = null!;

    private Models.Note? _note;

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [Parameter]
    public string NoteShortId { get; set; } = null!;

    [Parameter]
    public string? NoteSlug { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _note = await NoteQueryService.GetNoteByUsernameAndShortIdAsync(AuthorUsername, NoteShortId);

        if (_note == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out var currentUserGuid);
        IsCurrentUserAuthor = parsed && _note.UserId == currentUserGuid;

        if (_note.Access == Access.Private && !IsCurrentUserAuthor)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var slug = SlugGenerator.FromTitle(_note.Title);
        if (NoteSlug != slug)
        {
            NavigationManager.NavigateTo(LinkManager.LinkToHistory(_note));
            return;
        }

        Model = await NoteQueryService.GetNoteRevisionsAsync(_note.Id);
        IsSuccessfullyInitialized = true;
    }

}