@page "/tag/{Tag}"
@using System.Security.Claims
@using Niwa.Models
@using Niwa.Services.Converters
@using Niwa.Services.NoteServices
@using Niwa.Components.Cards
@inject INoteToNoteCardConverter NoteToNoteCardConverter
@inject INoteQueryService NoteQueryService

@if (IsSuccessfullyInitialized)
{
    <PageTitle>@Tag</PageTitle>
    <HeaderTitle>@Tag</HeaderTitle>

    <h3>Tag: @Tag</h3>

    @if (Notes.Count > 0)
    {
        <div>
            <form>
                <input placeholder="Search query" type="search"/>
                <button>Search</button>
            </form>
        </div>
        <div class="cards">
            @foreach (var note in Notes)
            {
                <NoteCard Model="@NoteToNoteCardConverter.Convert(note)"></NoteCard>
            }
        </div>
    }
    else
    {
        <p>No notes with this tag.</p>
    }
}
else
{
    <Error/>
}

@code {

    private List<Note> Notes { get; set; } = [];

    [Parameter]
    public string Tag { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUser);
        Notes = await NoteQueryService.GetNotesByTagAsync(currentUser, Tag);
        IsSuccessfullyInitialized = true;
    }

}