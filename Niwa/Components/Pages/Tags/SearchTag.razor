@page "/tag/{Tag}"
@using System.Security.Claims
@using Niwa.Dtos.NoteDtos
@using Niwa.Search.Services
@using Niwa.Services
@using Niwa.Services.Converters
@using Niwa.Services.NoteServices
@using Niwa.Components.Forms
@inject INoteQueryService NoteQueryService
@inject INoteToNoteCardConverter NoteToNoteCardConverter
@inject INoteSearchQueryService NoteSearchQueryService
@inject ILinkManager LinkManager

@if (IsSuccessfullyInitialized)
{
    <PageTitle>@Tag</PageTitle>
    <HeaderTitle>@Tag</HeaderTitle>

    <h3>Tag: @Tag</h3>

    <NoteSearchForm Notes="Notes" Query="@Query"></NoteSearchForm>
}
else
{
    <Error/>
}

@code {

    private List<NoteCardQueryDto> Notes { get; set; } = [];

    [Parameter]
    public string Tag { get; set; } = null!;

    [SupplyParameterFromQuery(Name = "q")]
    public string? Query { get; set; }

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUser);
        if (!string.IsNullOrEmpty(Query))
        {
            Notes = (await NoteSearchQueryService.SearchTagNotesAsync(Query, Tag, currentUser)).Select(note => new NoteCardQueryDto
            {
                Url = LinkManager.LinkToNote(note.Author, note.ShortId, note.Title),
                Title = note.Title,
                Image = note.Image,
                Garden = note.GardenTitle,
                Summary = note.Summary,
                Access = note.Access,
                Tags = note.Tags.ToList()
            }).ToList();
        }
        else
        {
            Notes = (await NoteQueryService.GetNotesByTagAsync(currentUser, Tag)).Select(NoteToNoteCardConverter.Convert).ToList();
        }

        IsSuccessfullyInitialized = true;
    }

}