@page "/link"
@using OpenGraphNet.Metadata
@using Niwa.Components.Cards
@using OpenGraphNet
@using System.Globalization

@if (IsSuccessfullyInitialized)
{
    <PageTitle>External link - @Model!.LinkTitle</PageTitle>
    <HeaderTitle>External link</HeaderTitle>
    <h5>External link</h5>

    <ExternalLinkPreviewCard Model="Model"/>
}
else
{
    <Error/>
}

@code {

    [SupplyParameterFromQuery]
    public string? Url { get; set; }

    public ExternalLinkPreviewCard.ExternalLinkTemp? Model { get; set; }

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Url == null || !Uri.IsWellFormedUriString(Url, UriKind.Absolute))
            return;
        Model ??= new ExternalLinkPreviewCard.ExternalLinkTemp();
        try
        {
            var graph = await OpenGraph.ParseUrlAsync(Url, timeout: 1000);
            Model.LinkTitle = graph.Title.Length == 0 ? Url : graph.Title;
            Model.LinkUrl = graph.Url?.ToString() ?? Url;
            Model.LinkImage = graph.Image?.ToString();
            Model.LinkDescription = graph.Metadata["og:description"].Value();
            Model.AccessDate = DateTime.UtcNow.ToString(CultureInfo.InvariantCulture);
        }
        catch
        {
            Model.LinkUrl = Url;
            Model.LinkTitle = Url;
            Model.AccessDate = DateTime.UtcNow.ToString(CultureInfo.InvariantCulture);
            Model.LinkDescription = "";
            Model.LinkImage = "";
        }

        IsSuccessfullyInitialized = true;
    }

}