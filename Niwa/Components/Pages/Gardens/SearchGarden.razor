@page "/garden/{authorUsername}/search"
@using System.Security.Claims
@using Niwa.Services.GardenServices
@using Niwa.Components.Forms
@inject IGardenQueryService GardenQueryService

@if (IsSuccessfullyInitialized)
{
    <PageTitle>@Model!.Title</PageTitle>
    <HeaderTitle>@Model!.Title</HeaderTitle>

    <h3>@Model!.Title</h3>

    <NoteSearchForm Notes="Model!.Notes.ToList()"></NoteSearchForm>
}
else
{
    <Error/>
}

@code {

    private Models.Garden? Model { get; set; }

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private bool IsSuccessfullyInitialized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var parsed = Guid.TryParse(HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier), out var userId);
        if (!parsed)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        Model ??= await GardenQueryService.GetGardenWithNotes(userId, AuthorUsername);
        IsSuccessfullyInitialized = true;
    }

}