@page "/garden/{authorUsername}"
@using System.Security.Claims
@using Niwa.Dtos.GardenDtos
@using Niwa.Services
@using Niwa.Services.Converters
@using Niwa.Services.GardenServices
@using Niwa.Services.SubscriptionServices
@using Niwa.Components.Cards
@inject NavigationManager NavigationManager
@inject ILinkManager LinkManager
@inject IGardenQueryService GardenQueryService
@inject IGardenToGardenPageConverter GardenToGardenPageConverter
@inject ISubscriptionCommandService SubscriptionCommandService

@if (SuccessfullyInitialized)
{
    <PageTitle>@Model.Title</PageTitle>
    <HeaderTitle>
        <RegularLink To="@LinkManager.LinkToGarden(AuthorUsername)">@Model.Title</RegularLink>
    </HeaderTitle>
    <h1>@Model.Title</h1>
    <ActionsContainer>
        <ActionsLeft>
            <ActionLink To="search" RelativeTo="@NavigationManager.Uri">Search all notes</ActionLink>
            <AuthorizeView>
                <Authorized>
                    @if (IsCurrentUserSubscribed)
                    {
                        <form data-enhance method="post" @onsubmit="() => SubscribeToGarden(false)" @formname="UnsubscribeFromNote">
                            <AntiforgeryToken/>
                            <button class="btn-link">Unsubscribe</button>
                        </form>
                    }
                    else
                    {
                        <form data-enhance method="post" @onsubmit="() => SubscribeToGarden(true)" @formname="SubscribeToNote">
                            <AntiforgeryToken/>
                            <button class="btn-link">Subscribe to updates</button>
                        </form>
                    }
                </Authorized>
            </AuthorizeView>
        </ActionsLeft>
        <ActionsRight>
            @if (IsCurrentUserAuthor)
            {
                <ActionLink To="edit" RelativeTo="@NavigationManager.Uri">Edit</ActionLink>
            }
        </ActionsRight>
    </ActionsContainer>

    <blockquote>
        <Markdown Content="@Model.Summary"/>
    </blockquote>

    @if (Model.FeaturedNotes.Count > 0)
    {
        <h5>Featured notes</h5>

        <div class="cards">
            @foreach (var note in Model.FeaturedNotes)
            {
                <NoteCard Model="note"/>
            }
        </div>
    }
}
else
{
    <Error/>
}


@code {

    [Parameter]
    public string AuthorUsername { get; set; } = null!;

    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = null!;

    private GardenPageQueryDto Model { get; set; } = new();

    private Models.Garden? _garden;

    private Guid _currentUserGuid;

    private bool SuccessfullyInitialized { get; set; }

    private bool IsCurrentUserAuthor { get; set; }

    private bool IsCurrentUserSubscribed { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _garden = await GardenQueryService.GetFirstByUsernameAsync(AuthorUsername, true);
        if (_garden == null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        var currentUserId = HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var parsed = Guid.TryParse(currentUserId, out _currentUserGuid);
        IsCurrentUserAuthor = parsed && _garden.UserId == _currentUserGuid;
        if (parsed) IsCurrentUserSubscribed = await GardenQueryService.IsUserSubscribedAsync(_currentUserGuid, _garden);
        Model = GardenToGardenPageConverter.Convert(_garden, !IsCurrentUserAuthor);
        SuccessfullyInitialized = true;
    }

    private async Task SubscribeToGarden(bool subscribe)
    {
        if (_garden == null)
            return;
        await SubscriptionCommandService.SubscribeToGardenAsync(_currentUserGuid, _garden.Id, subscribe);
        IsCurrentUserSubscribed = subscribe;
    }

}